{
  "name": "dsh-mc-companion",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Minecraft AI companion for DeepSeek Harness: headless Mineflayer bot, mode-gated tools, follow/chat, schematic building and autonomous explore/woodcut/mine/fight behaviours. Speaks Minecraft 1.20.4 and 26.3 (protocol 777) natively.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "scripts",
    "vendor",
    "README.md"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "postinstall": "node scripts/install-263-compat.mjs",
    "compat:263": "node scripts/install-263-compat.mjs",
    "compat:263:check": "node scripts/install-263-compat.mjs --check",
    "test": "node test/gating.test.mjs && node test/schematic.test.mjs && node test/builder.test.mjs && node test/scaffold.test.mjs && node test/behaviors.test.mjs && node test/navigation.test.mjs && node test/capabilities.test.mjs && node test/dashboard.test.mjs && node test/status-context.test.mjs && node test/compat263.test.mjs && node test/dig.test.mjs",
    "test:gate": "node test/gating.test.mjs",
    "eval": "node test/eval/run.mjs",
    "test:compat263": "node test/compat263.test.mjs",
    "test:26": "node test/native263.integration.mjs",
    "test:26:via": "node test/compat263.integration.mjs",
    "test:scaffold": "node test/scaffold.integration.mjs",
    "test:integration": "node test/integration.mjs",
    "server:setup": "node scripts/setup-test-server.mjs",
    "server:start": "node scripts/start-test-server.mjs",
    "server:26": "node scripts/test-server-26.mjs",
    "probe:26": "node tools/probe-263.mjs",
    "verify:26": "node tools/mcdata263/verify-263.mjs",
    "test:behaviors": "node test/behaviors.test.mjs",
    "test:behaviors:e2e": "node test/behaviors.integration.mjs",
    "test:navigation": "node test/navigation.test.mjs",
    "test:capabilities": "node test/capabilities.test.mjs",
    "test:capabilities:e2e": "node test/capabilities.integration.mjs",
    "test:viewer:e2e": "node test/viewer.integration.mjs",
    "test:solo": "node test/solo.test.mjs",
    "test:solo:e2e": "node test/solo.integration.mjs",
    "test:gather:e2e": "node test/gather.integration.mjs",
    "test:speedrun:e2e": "node test/speedrun.integration.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "minecraft-data": "^3.85.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-block": "^1.22.0",
    "prismarine-item": "^1.17.0",
    "prismarine-schematic": "^1.3.0",
    "prismarine-viewer": "^1.33.0",
    "vec3": "^0.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
